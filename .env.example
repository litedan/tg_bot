# Токен Telegram-бота от @BotFather
BOT_TOKEN=сюда_вставить_токен

# API-ключ из кабинета OpenRouter
OPENROUTER_API_KEY=сюда_вставить_ключ

# Модель OpenRouter; openrouter/free выбирает доступную бесплатную модель
# Для бесплатных моделей возможны ограничения по скорости и дневному лимиту.
OPENROUTER_MODEL=openrouter/free
