# Токен Telegram-бота от @BotFather
BOT_TOKEN=сюда_вставить_токен

# API-ключ из кабинета OpenRouter
OPENROUTER_API_KEY=сюда_вставить_ключ

# Фиксированная tool-capable модель (не openrouter/free — он выбирает модель случайно).
# Бесплатные варианты имеют лимит 50 запросов/день на аккаунт.
# Примеры стабильных платных (нужны кредиты): openai/gpt-oss-120b, z-ai/glm-5.2
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Резервная модель: включается, если основная выдаёт 429/5xx после всех ретраев.
# Оставьте пустым, чтобы отключить.
# OPENROUTER_FALLBACK_MODEL=google/gemma-2-27b-it:free

# --- Агент ---
# Максимум шагов «модель -> инструменты -> модель» на один вопрос.
AGENT_MAX_STEPS=4
# Сколько последних сообщений диалога держать в контексте.
HISTORY_LIMIT=8
# Таймаут запроса к LLM, секунды.
LLM_REQUEST_TIMEOUT=120

# --- Ретраи LLM при 429/перегрузке ---
# Количество подряд идущих попыток (паузы: Retry-After или 2/4/8... сек, не выше 20).
# LLM_RETRIES=3
# LLM_RETRY_BASE_DELAY=2
# LLM_RETRY_MAX_DELAY=20

# --- Веб-поиск ---
# WEB_SEARCH_ENABLED=true
# WEB_SEARCH_MAX_RESULTS=5
# WEB_SEARCH_REGION=ru-ru

# --- Чтение веб-страниц ---
# WEB_READ_ENABLED=true
# WEB_READ_TIMEOUT=15
# WEB_READ_MAX_CHARS=6000

# --- Перезапись запроса с учётом диалога ---
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_MESSAGES=6

# --- Входной слой (input_layer.py) ---
# Максимальная длина запроса после очистки, символов.
# INPUT_MAX_CHARS=4000
# Лимит частоты на пользователя: не больше N сообщений за W секунд.
# INPUT_RATE_LIMIT=10
# INPUT_RATE_WINDOW=60
# Блокировка сообщений-«контрабандистов»: доля невидимых символов и минимальная длина.
# INPUT_INVISIBLE_MAX_RATIO=0.05
# INPUT_INVISIBLE_MIN_CHARS=100

# --- RAG (значения по умолчанию можно не задавать) ---
# COLLECTION_NAME=ru_knowledge_base_v2
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# RETRIEVAL_CANDIDATES=12
# RERANKED_DOCUMENTS=4
# MIN_RERANK_SCORE=-4.0
